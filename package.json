{
  "name": "logging",
  "version": "0.0.1",
  "description": "Modulo reutilizable de logging, eventos, mensajes y reportes para aplicaciones Node.js: agnóstico de framework web y motor de persistencia, con pipeline síncrono, contexto distribuido (AsyncLocalStorage/OpenTelemetry), sampling y rate limiting, redacción de campos sensibles, transports pluggables y reporting con autorización RBAC + scopes.",
  "author": "Franco Emanuel Aban Tejerina",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"*.json\" \"*.config.*\" README.md",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"*.json\" \"*.config.*\" README.md",
    "validate": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test:coverage && pnpm run build"
  },
  "keywords": [
    "logging",
    "events",
    "messages",
    "reports",
    "observability"
  ],
  "license": "MIT",
  "dependencies": {
    "cockatiel": "^4.0.0",
    "rotating-file-stream": "^3.2.10",
    "zod": "^4.6.5",
    "@pinojs/redact": "^0.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "4.1.11"
  }
}
